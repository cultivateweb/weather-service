# Настройки сервиса. Строки, которые начинаются с #, пропускаются.
# Любую настройку можно переопределить переменной окружения с тем же именем.

PORT=8080

# Файл журнала. Пусто — в файл не писать (только на экран и в базу).
LOG_PATH=service.log

# Журнал в базу PostgreSQL: адрес базы. Пусто — в базу не писать.
# Пароль сюда не пиши: этот файл лежит в git. libpq (библиотека PostgreSQL)
# сама берёт пароль из переменной окружения PGPASSWORD.
# Адрес базы из compose.yaml: postgresql://weather@127.0.0.1:5432/weather
DB_URL=

# Адреса погодного API (open-meteo.com, ключ не нужен)
WEATHER_URL=https://api.open-meteo.com/v1/forecast
GEO_URL=https://geocoding-api.open-meteo.com/v1/search

# Язык поиска города и названий в ответе: uk — украинский, ru — русский, en — английский.
# Латиницу (Kyiv) сайт находит на любом языке, а кириллицу — только на её языке:
# «Київ» — с uk, «Киев» — с ru.
GEO_LANGUAGE=uk
