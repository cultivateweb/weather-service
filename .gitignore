# Папки сборки: cmake -B build, cmake -B build-check, scripts/build-static.sh;
# out — файл программы из docker build --target file --output out .
build*/
out/

# Что создаёт запущенный сервис (LOG_PATH из config.env)
service.log

# Пароль базы для compose.yaml: пароли в git не храним
.env

# Что оставляют тесты, если запускать их не из папки сборки
test.env
test_*.log
test_*.out
